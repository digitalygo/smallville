# smallville environment configuration
# Copy this file to .env and fill in your values.

# ---------------------------------------------------------------------------
# OpenRouter provider (default)
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key

# ---------------------------------------------------------------------------
# OpenRouter attribution headers
#   These let OpenRouter attribute API usage to your app.
# ---------------------------------------------------------------------------
OPENROUTER_REFERER=https://github.com/digitalygo/smallville
OPENROUTER_TITLE=smallville
OPENROUTER_CATEGORIES=game,roleplay

# ---------------------------------------------------------------------------
# OpenAI provider (optional fallback)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-your-openai-api-key

# ---------------------------------------------------------------------------
# Default provider and model
#   LLM_PROVIDER: "openrouter" or "openai"
#   LLM_MODEL: provider-specific model name (optional; sensible default used if unset)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openrouter
# LLM_MODEL=openai/gpt-4o

# ---------------------------------------------------------------------------
# Per-persona model overrides (JSON map)
#   Keys are persona names, values are "openrouter:<model>" or bare "<model>"
#   Example: LLM_PERSONA_MODELS='{"Isabella Rodriguez":"openrouter:anthropic/claude-3.5-sonnet","Maria Lopez":"gpt-4o"}'
# ---------------------------------------------------------------------------
# LLM_PERSONA_MODELS='{}'

# ---------------------------------------------------------------------------
# Owner and debug
# ---------------------------------------------------------------------------
KEY_OWNER=developer
DEBUG=false

# ---------------------------------------------------------------------------
# Django settings (used by environment/frontend_server)
# ---------------------------------------------------------------------------
# Generate a new secret key: uv run python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ENV=dev
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# DJANGO_SECURE_SSL_REDIRECT=false  # default is true in prod compose; set false if no reverse proxy

# ---------------------------------------------------------------------------
# Database  (defaults to SQLite; set DATABASE_URL for PostgreSQL)
#   In docker compose, DATABASE_URL is auto-composed from POSTGRES_* below.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://user:password@host:5432/smallville

# ---------------------------------------------------------------------------
# Container deployment (docker compose)
#   These compose the DATABASE_URL and configure the db/web/backend services.
#   All have sensible defaults; only set when you need custom values.
# ---------------------------------------------------------------------------
# POSTGRES_USER=smallville
# POSTGRES_PASSWORD=smallville
# POSTGRES_DB=smallville
# WEB_PORT=8000
# REVERIE_AUTOSAVE_INTERVAL=10

# ---------------------------------------------------------------------------
# Reverie backend service mode  (used by reverie.py --serve)
# ---------------------------------------------------------------------------
# REVERIE_FORK_SIM_CODE=base_the_ville_isabella_maria_klaus
# REVERIE_SIM_CODE=MySimulation
